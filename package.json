{
  "name": "editeur-de-tests",
  "version": "1.0.0",
  "description": "Éditeur de tests pour le site Test de réflexion",
  "main": "main.js",
  "author": "braintest",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "io.github.braintest.editeur",
    "productName": "Editeur de tests",
    "files": ["main.js", "preload.js", "login.html", "editeur.html", "icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Editeur-de-tests-Setup.exe"
    },
    "publish": [
      { "provider": "github", "owner": "alexandrebossboss666-code", "repo": "braintest" }
    ]
  }
}

